// Large schema fixture for schema slicing (action closure) benchmarks.
//
// 3 entity types: principals User and Agent, resource Document.
// 2000 leaf actions a0000..a1999. Each is a member of three action groups:
// g, m, and p<NN> where NN = floor(n / 100), so a0000..a0099 are in p00 and
// a1900..a1999 are in p19. Every leaf action has the same inline context.
// The 22 action groups have no appliesTo and no context.

entity User;
entity Agent;
entity Document;

action "g";
action "m";
action "p00";
action "p01";
action "p02";
action "p03";
action "p04";
action "p05";
action "p06";
action "p07";
action "p08";
action "p09";
action "p10";
action "p11";
action "p12";
action "p13";
action "p14";
action "p15";
action "p16";
action "p17";
action "p18";
action "p19";

action "a0000" in ["g", "m", "p00"] appliesTo {
  principal: [User, Agent],
  resource: Document,
  context: { a: String, b: String, c: String, d: decimal, e: Set<String> }
};
