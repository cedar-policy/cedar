---
source: cedar-policy-formatter/src/pprint/fmt.rs
assertion_line: 270
expression: formatted
input_file: cedar-policy-formatter/tests/like_delimited.cedar
---
// Delimiter-aware `like(pattern, delim)`.
permit (principal, action, resource)
when { context.host like("*.example.com", ".") };

// Path pattern with `/` delimiter.
permit (principal, action, resource)
when { context.path like("/repos/*/pulls/*/reviews", "/") };

// `**` (multi-wildcard) crosses the delimiter.
permit (principal, action, resource)
when { context.host like("**.example.com", ".") };
